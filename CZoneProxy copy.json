  },
  {
    "id": "cz_link_in_cmd",
    "type": "link in",
    "z": "czone_tab_v3",
    "name": "CZone Ext Cmd",
    "links": [],
    "x": 495,
    "y": 600,
    "wires": [
      [
        "cz_control_engine"
      ]
    ]
  },
  {
    "id": "cz_control_engine",
    "type": "function",
    "z": "czone_tab_v3",
    "name": "Control Engine",
    "func": "// CZone Control Engine v4\n// Input: { switch: 1-11, action: 'on'|'off'|'toggle' }\n//\n// On/Off circuits (1,2,3): sends desired state directly\n// Toggle circuits (4-11):  sends toggle pulse only if state differs\n// Sets 3-second suppression window to prevent UI bounce\n\nvar cmd = msg.payload;\nif (!cmd || !cmd.switch || !cmd.action) {\n    node.warn('Need {switch: 1-11, action: on|off|toggle}');\n    return null;\n}\n\nvar sw = parseInt(cmd.switch);\nvar action = cmd.action.toLowerCase();\nif (sw < 1 || sw > 11) { node.warn('Switch must be 1-11'); return null; }\n\nvar ONOFF = [1, 2, 3];\nvar isOnOff = ONOFF.indexOf(sw) !== -1;\n\nvar states = flow.get('switchStates') || {};\nvar cur = states[sw];\nvar isOn = (cur === 1);\nvar known = (cur !== undefined);\n\nvar names = {1:'Bilge Pump 1',2:'Bilge Pump 2',3:'Horn',4:'Helm Lights',5:'Nav Lights',6:'Anchor Light',7:'Red Light',8:'Flybridge Lights',9:'Underwater Light',10:'Bow Light 1',11:'Bow Light 2'};\n\nvar sendValue = -1;\nvar reason = '';\n\nif (isOnOff) {\n    if (action === 'on') {\n        if (known && isOn) { node.status({fill:'yellow',shape:'ring',text:names[sw]+' already ON'}); return null; }\n        sendValue = 1; reason = 'ON';\n    } else if (action === 'off') {\n        if (known && !isOn) { node.status({fill:'yellow',shape:'ring',text:names[sw]+' already OFF'}); return null; }\n        sendValue = 0; reason = 'OFF';\n    } else if (action === 'toggle') {\n        sendValue = isOn ? 0 : 1;\n        reason = isOn ? 'toggle→OFF' : 'toggle→ON';\n    }\n} else {\n    // Toggle circuits: 01 = momentary press = toggles\n    if (action === 'toggle') {\n        sendValue = 1; reason = 'toggle pulse';\n    } else if (action === 'on') {\n        if (known && isOn) { node.status({fill:'yellow',shape:'ring',text:names[sw]+' already ON'}); return null; }\n        sendValue = 1; reason = known ? 'toggle→ON' : 'toggle(?)→ON';\n    } else if (action === 'off') {\n        if (known && !isOn) { node.status({fill:'yellow',shape:'ring',text:names[sw]+' already OFF'}); return null; }\n        sendValue = 1; reason = known ? 'toggle→OFF' : 'toggle(?)→OFF';\n    }\n}\n\nif (sendValue < 0) return null;\n\n// Set suppression window: State Tracker will ignore SK syncs\n// for this switch for 3 seconds to prevent UI bounce\nvar pending = flow.get('pendingCmd') || {};\npending[sw] = Date.now();\nflow.set('pendingCmd', pending);\n\n// Build PGN 127502: byte 0 = instance 1, bytes 1-7 = switch commands\n// 2 bits per switch: 00=Off, 01=On, 11=NoChange (0xFF = all NoChange)\nvar data = [0x01, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF];\nvar byteIdx = Math.floor((sw - 1) / 4) + 1;\nvar bitPos = ((sw - 1) % 4) * 2;\nvar mask = ~(0x03 << bitPos) & 0xFF;\ndata[byteIdx] = (data[byteIdx] & mask) | (sendValue << bitPos);\n\nvar hex = data.map(function(b) { return ('0'+b.toString(16).toUpperCase()).slice(-2); }).join('');\n\nmsg.payload = 'cansend can0 09F20EFE#' + hex;\nmsg.switchNum = sw;\nmsg.switchName = names[sw];\nmsg.reason = reason;\n\nnode.status({fill:'blue',shape:'dot',text:names[sw]+' '+reason+' @'+new Date().toLocaleTimeString()});\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "x": 590,
    "y": 600,
    "wires": [
      [
        "cz_exec_send",
        "cz_debug_cmd"
      ]
    ]
  },
