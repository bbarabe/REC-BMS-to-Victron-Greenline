  {
    "id": "cz_state_tracker",
    "type": "function",
    "z": "czone_tab_v3",
    "name": "State Tracker (11 out)",
    "func": "// Extract switch number from SK path\nvar path = msg.topic || '';\nvar m = path.match(/bank\\.1\\.(\\d+)\\.state/);\nif (!m) return null;\n\nvar sw = parseInt(m[1]);\nif (sw < 1 || sw > 11) return null;\n\nvar states = flow.get('switchStates') || {};\nvar oldState = states[sw];\nvar newState = (msg.payload === 1 || msg.payload === '1' || msg.payload === true) ? 1 : 0;\n\n// Always store the real CZone state\nstates[sw] = newState;\nflow.set('switchStates', states);\n\n// Check suppression window: after a command, ignore SK sync\n// for 3 seconds to prevent toggle bounce in the UI\nvar pending = flow.get('pendingCmd') || {};\nif (pending[sw] && (Date.now() - pending[sw]) < 5000) {\n    // State stored but NOT synced to virtual switch\n    return null;\n}\n// Clear expired entry\nif (pending[sw]) {\n    delete pending[sw];\n    flow.set('pendingCmd', pending);\n}\n\n// Build sync message for virtual switch\nvar syncMsg = {payload: {}};\nsyncMsg.payload['/SwitchableOutput/output_1/State'] = newState;\nsyncMsg._czoneSync = true;\n\n// Route to correct output (0=sw1 ... 10=sw11)\nvar outputs = [null,null,null,null,null,null,null,null,null,null,null];\noutputs[sw - 1] = syncMsg;\n\nvar names = {1:'Bilge1',2:'Bilge2',3:'Horn',4:'Helm',5:'Nav',6:'Anchor',7:'Red',8:'Fly',9:'Underwater',10:'Bow1',11:'Bow2'};\nif (oldState !== newState) {\n    node.status({fill: newState ? 'green' : 'grey', shape: 'dot',\n        text: names[sw] + ': ' + (newState ? 'ON' : 'OFF') + ' @' + new Date().toLocaleTimeString()});\n}\n\nreturn outputs;",
    "outputs": 11,
    "timeout": "",
    "noerr": 0,
    "initialize": "flow.set('switchStates', {});\nflow.set('pendingCmd', {});",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 280,
    "wires": [
      [
        "cz_vs_sw1"
      ],
      [
        "cz_vs_sw2"
      ],
      [
        "cz_vs_sw3"
      ],
      [
        "cz_vs_sw4"
      ],
