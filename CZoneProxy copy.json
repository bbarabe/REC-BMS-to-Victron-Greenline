  {
    "id": "cz_show_states",
    "type": "function",
    "z": "czone_tab_v3",
    "name": "Show All States",
    "func": "var states = flow.get('switchStates') || {};\nvar names = {1:'Bilge Pump 1',2:'Bilge Pump 2',3:'Horn',4:'Illumination Helm',5:'Navigation Lights',6:'Anchor Light',7:'Red Light',8:'Illumination Fly',9:'Underwater Light',10:'Bow light 1',11:'Bow light 2'};\nvar lines = [];\nfor (var i = 1; i <= 11; i++) {\n    var s = states[i];\n    var st = (s === 1) ? 'ON ' : (s === 0) ? 'OFF' : '???';\n    lines.push('Sw' + (i<10?' ':'') + i + ' ' + st + '  ' + names[i]);\n}\nmsg.payload = lines.join('\\n');\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "x": 830,
    "y": 60,
    "wires": [
      [
        "cz_debug_all"
      ]
    ]
  },
