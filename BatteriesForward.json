  {
    "id": "bat1_assembler",
    "type": "function",
    "z": "bat_tab",
    "name": "House Assembler",
    "func": "var bat = flow.get('bat1') || {};\nvar path = msg.topic || '';\nvar val = msg.payload;\n\nif (path.indexOf('voltage') >= 0) bat.voltage = val;\nelse if (path.indexOf('current') >= 0) bat.current = val;\nelse if (path.indexOf('stateOfCharge') >= 0) bat.soc = val * 100;\n\nbat._lastUpdate = Date.now();\nflow.set('bat1', bat);\nreturn null;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "flow.set('bat1', {});",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 120,
    "wires": [
      []
    ]
  },
