  {
    "id": "bat_publisher",
    "type": "function",
    "z": "bat_tab",
    "name": "Publish All Batteries",
    "func": "var bat1 = flow.get('bat1') || {};\nvar bat2 = flow.get('bat2') || {};\nvar bat3 = flow.get('bat3') || {};\nvar now = Date.now();\n\nfunction isLive(bat) {\n    return bat._lastUpdate && (now - bat._lastUpdate) <= 10000;\n}\n\nvar msgs = [null, null, null];\n\nif (isLive(bat1)) {\n    msgs[0] = { payload: {\n        \"/Dc/0/Voltage\": bat1.voltage || 0,\n        \"/Dc/0/Current\": bat1.current || 0,\n        \"/Dc/0/Power\": Math.round((bat1.voltage || 0) * (bat1.current || 0) * 10) / 10,\n        \"/Soc\": bat1.soc || 0\n    }};\n}\n\nif (isLive(bat2)) {\n    msgs[1] = { payload: {\n        \"/Dc/0/Voltage\": bat2.voltage || 0,\n        \"/Soc\": bat2.soc || 0\n    }};\n}\n\nif (isLive(bat3)) {\n    msgs[2] = { payload: {\n        \"/Dc/0/Voltage\": bat3.voltage || 0,\n        \"/Soc\": bat3.soc || 0\n    }};\n}\n\nvar labels = ['House', 'Bow', 'Stern'];\nvar parts = [];\nfor (var i = 0; i < 3; i++) {\n    var bat = [bat1, bat2, bat3][i];\n    var live = isLive(bat);\n    parts.push(labels[i] + ': ' + (live ? (bat.voltage || 0).toFixed(1) + 'V' : 'STALE'));\n}\nnode.status({ fill: 'green', shape: 'dot', text: parts.join(' | ') });\n\nreturn msgs;",
    "outputs": 3,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 580,
    "wires": [
      [
        "bat1_virtual"
      ],
      [
        "bat2_virtual"
      ],
      [
        "bat3_virtual"
      ]
    ]
  },
